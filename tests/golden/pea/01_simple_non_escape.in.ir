// .JADE Compiler — tests/golden/pea/01_simple_non_escape.in.ir
//
// Simplest non-escaping allocation: alloc + store + load + return(load).
// PEA should scalar-replace everything and eliminate the Allocate.

graph simple_non_escape {
    %1 = Start
    %2 = ConstInt 42
    %3 = Allocate shape=1
    %4 = StoreField %3, off=0, %2    effect_in=%3
    %5 = LoadField %3, off=0        effect_in=%4
    %6 = Return %5                  ctrl_in=%1 effect_in=%5
}
