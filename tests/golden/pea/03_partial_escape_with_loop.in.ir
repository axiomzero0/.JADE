// Golden IR test for PEA — allocation inside a loop that doesn't escape.
//
// Source pattern:
//   sum = 0;
//   for (i = 0; i < 10; i++) {
//     temp = new Object();   // allocation inside loop — never escapes
//     temp.field = i;
//     sum = sum + temp.field;
//   }
//   return sum;
//
// The temp allocation never escapes the loop body. PEA should eliminate it
// on every iteration — the hot path has zero allocations.

graph partial_escape_with_loop {
    %1 = Start
    // sum = 0 (local 0)
    %2 = ConstInt 0
    %3 = StLoc local=0, %2    effect_in=%1
    // i = 0 (local 1)
    %4 = ConstInt 0
    %5 = StLoc local=1, %4    effect_in=%3
    // N = 10 (local 2)
    %6 = ConstInt 10
    %7 = StLoc local=2, %6    effect_in=%5
    // Loop header
    %8 = Loop                 ctrl_in=%1 effect_in=%7
    // i < N
    %9 = LdLoc local=1
    %10 = LdLoc local=2
    %11 = Lt %9, %10
    %12 = If %11              ctrl_in=%8 effect_in=%8
    // IfFalse → exit: return sum
    %13 = IfFalse              ctrl_in=%12
    %14 = LdLoc local=0
    %15 = Return %14           ctrl_in=%13 effect_in=%13
    // IfTrue → body: temp = new Object(); temp.field = i; sum += temp.field; i++
    %16 = IfTrue               ctrl_in=%12
    %17 = Allocate shape=1    effect_in=%16
    %18 = LdLoc local=1
    %19 = StoreField %17, off=0, %18   effect_in=%17
    %20 = LoadField %17, off=0         effect_in=%19
    %21 = LdLoc local=0
    %22 = Add %21, %20
    %23 = StLoc local=0, %22   effect_in=%20
    %24 = LdLoc local=1
    %25 = ConstInt 1
    %26 = Add %24, %25
    %27 = StLoc local=1, %26   effect_in=%23
    %28 = Jump                  ctrl_in=%27 effect_in=%27
}
